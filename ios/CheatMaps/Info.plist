  <key>NSPrivacyAccessedAPITypes</key>
  <dict>
    <!-- New Category for Boot Time -->
      <key>NSPrivacyAccessedAPICategorySystemBootTime</key>
      <array>
          <string>35F9.1</string>
          <string>8FFB.1</string>
